<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.seezoon.domain.dao.mapper.SysUserRoleMapper">
    <resultMap id="BaseResultMap" type="com.seezoon.domain.dao.po.SysUserRolePO">
        <id column="uid" jdbcType="INTEGER" property="uid"/>
        <id column="role" jdbcType="VARCHAR" property="role"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        uid, role, create_time
    </sql>

    <select id="selectByUid" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from sys_user_role
        where uid = #{uid,jdbcType=INTEGER}
    </select>

    <select id="selectByCondition" resultMap="BaseResultMap"
            parameterType="com.seezoon.domain.dao.po.SysUserRolePO$Condition">
        select
        <include refid="Base_Column_List"/>
        from sys_user_role
        <where>
            <if test="uid != null">
                and uid = #{uid,jdbcType=INTEGER}
            </if>
            <if test="role != null and role != ''">
                and role = #{role,jdbcType=VARCHAR}
            </if>
        </where>
    </select>

    <delete id="deleteByUid" parameterType="java.lang.Integer">
        delete from sys_user_role
        where uid = #{uid,jdbcType=INTEGER}
    </delete>

    <delete id="deleteByUidAndRole">
        delete from sys_user_role
        where uid = #{uid,jdbcType=INTEGER} and role = #{role,jdbcType=VARCHAR}
    </delete>

    <insert id="insert" parameterType="com.seezoon.domain.dao.po.SysUserRolePO">
        insert into sys_user_role (uid, role, create_time)
        values (#{uid,jdbcType=INTEGER}, #{role,jdbcType=VARCHAR}, #{createTime,jdbcType=TIMESTAMP})
    </insert>

    <insert id="batchInsert" parameterType="java.util.List">
        insert into sys_user_role (uid, role, create_time)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.uid,jdbcType=INTEGER}, #{item.role,jdbcType=VARCHAR}, #{item.createTime,jdbcType=TIMESTAMP})
        </foreach>
    </insert>
</mapper>

